# ─── AI Therapist API (Dr. Maya) ───────────────────────────────────────────
# HTTP base URL for the AI Therapist FastAPI service
VITE_THERAPIST_API_URL=http://localhost:8002
# WebSocket base URL for real-time therapy sessions
VITE_THERAPIST_WS_URL=ws://localhost:8002

# ─── TTS Microservice (Groq PlayAI) ────────────────────────────────────────
# HTTP base URL for TTS health/status endpoints
VITE_TTS_API_URL=http://localhost:8003
# WebSocket base URL for streaming TTS audio
VITE_TTS_WS_URL=ws://localhost:8003

# ─── STT Microservice (AssemblyAI) ─────────────────────────────────────────
# HTTP base URL for Speech-to-Text transcription endpoint
VITE_STT_API_URL=http://localhost:8004

# ─── Meditation Backend API ─────────────────────────────────────────────────
# HTTP base URL for the Meditation FastAPI service
VITE_MEDITATION_API_URL=http://localhost:8000

# ─── Journal Processing API ─────────────────────────────────────────────────
# HTTP base URL for the Journal Processing FastAPI service (port 8001 by default)
VITE_JOURNAL_PROCESSING_API_URL=http://localhost:8001

# ─── Gemini Live Therapist (Dr. Maya Live) ──────────────────────────────────
# API key for the @google/genai JS SDK — used directly in the browser for Live API
VITE_GEMINI_API_KEY=your_gemini_api_key_here
